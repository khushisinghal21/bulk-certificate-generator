# Copy to .env and adjust. Every value has a sensible default (see app/config.py).

# SQLite for quick local runs; PostgreSQL for anything real:
# DATABASE_URL=postgresql+psycopg://certgen:certgen@localhost:5432/certgen
DATABASE_URL=sqlite:///./data/certificates.db
STORAGE_DIR=./data/certificates

CELERY_BROKER_URL=redis://localhost:6379/0
# true = run generation inline in the API process (no Redis/worker). Dev only.
CELERY_TASK_ALWAYS_EAGER=false
CHUNK_SIZE=50
PROCESSING_LEASE_SECONDS=300

MAX_RECIPIENTS_PER_JOB=10000
MAX_CSV_BYTES=5242880

# Leave empty to disable auth; otherwise clients must send X-API-Key.
API_KEY=

# Base URL encoded in each certificate's verification QR code.
PUBLIC_BASE_URL=http://localhost:8000
